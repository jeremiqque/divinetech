---
interface Props { step: 1 | 2 | 3 | 4 }
const { step } = Astro.props;
const id = `pi${step}`;
---
<svg viewBox="0 0 320 190" class="h-full w-full" role="img" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id={`${id}-metal`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f4f4f4"/><stop offset=".5" stop-color="#b9b9b9"/><stop offset="1" stop-color="#e6e6e6"/></linearGradient>
    <linearGradient id={`${id}-glass`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffffff" stop-opacity=".38"/><stop offset="1" stop-color="#ffffff" stop-opacity=".06"/></linearGradient>
    <linearGradient id={`${id}-paper`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#dcdcdc"/></linearGradient>
    <linearGradient id={`${id}-dark`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#4a4a4a"/><stop offset="1" stop-color="#1c1c1c"/></linearGradient>
    <radialGradient id={`${id}-glow`} cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#fff" stop-opacity=".16"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></radialGradient>
    <filter id={`${id}-sh`} x="-20%" y="-20%" width="140%" height="150%"><feDropShadow dx="0" dy="5" stdDeviation="5" flood-color="#000" flood-opacity=".6"/></filter>
  </defs>
  <ellipse cx="160" cy="100" rx="150" ry="85" fill={`url(#${id}-glow)`} />

  {step === 1 && (
    <g>
      <!-- brief sheet -->
      <g filter={`url(#${id}-sh)`} transform="rotate(-4 120 100)">
        <rect x="64" y="26" width="116" height="144" rx="10" fill={`url(#${id}-paper)`} />
        <rect x="104" y="18" width="36" height="16" rx="6" fill={`url(#${id}-dark)`} stroke="#fff" stroke-opacity=".5" />
        <g fill="#2a2a2a">
          <rect x="78" y="48" width="64" height="6" rx="3"/>
        </g>
        <g stroke="#9a9a9a" stroke-width="4" stroke-linecap="round">
          <line x1="96" y1="72" x2="160" y2="72"/><line x1="96" y1="90" x2="150" y2="90"/><line x1="96" y1="108" x2="162" y2="108"/>
        </g>
        <g fill="#111">
          <circle cx="82" cy="72" r="6"/><circle cx="82" cy="90" r="6"/><circle cx="82" cy="108" r="6"/>
        </g>
        <g stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path d="M79 72l2 2 4-4"/><path d="M79 90l2 2 4-4"/><path d="M79 108l2 2 4-4"/>
        </g>
        <!-- design sketch -->
        <rect x="78" y="124" width="88" height="34" rx="6" fill="#efefef" stroke="#bdbdbd"/>
        <rect x="86" y="130" width="30" height="22" rx="2" fill="none" stroke="#333" stroke-width="2.4"/>
        <line x1="101" y1="130" x2="101" y2="152" stroke="#333" stroke-width="2"/>
        <rect x="124" y="130" width="34" height="22" rx="2" fill="none" stroke="#333" stroke-width="2.4"/>
        <line x1="124" y1="141" x2="158" y2="141" stroke="#333" stroke-width="2"/>
      </g>
      <!-- speech bubble -->
      <g filter={`url(#${id}-sh)`}>
        <path d="M196 38h82a12 12 0 0 1 12 12v40a12 12 0 0 1-12 12h-52l-18 14v-14h-12a12 12 0 0 1-12-12V50a12 12 0 0 1 12-12z" fill={`url(#${id}-metal)`} />
        <rect x="212" y="54" width="22" height="30" rx="2" fill="none" stroke="#222" stroke-width="3"/>
        <line x1="223" y1="54" x2="223" y2="84" stroke="#222" stroke-width="2.4"/>
        <rect x="244" y="54" width="30" height="30" rx="2" fill="none" stroke="#222" stroke-width="3"/>
        <circle cx="262" cy="70" r="2.4" fill="#222"/>
      </g>
      <!-- colour swatches -->
      <g filter={`url(#${id}-sh)`}>
        <rect x="204" y="128" width="26" height="40" rx="6" fill="#111" stroke="#fff" stroke-opacity=".7"/>
        <rect x="234" y="128" width="26" height="40" rx="6" fill="#B8794A" stroke="#fff" stroke-opacity=".7"/>
        <rect x="264" y="128" width="26" height="40" rx="6" fill="#e8e8e8"/>
        <path d="M204 150h26v18a6 6 0 0 1-6 6h-14a6 6 0 0 1-6-6z" fill="#fff" opacity=".12"/>
      </g>
      <!-- pencil -->
      <g transform="rotate(38 262 108)" filter={`url(#${id}-sh)`}>
        <rect x="190" y="100" width="92" height="12" rx="3" fill={`url(#${id}-metal)`}/>
        <path d="M282 100l16 6-16 6z" fill="#f1e6d6"/><path d="M293 104l5 2-5 2z" fill="#111"/>
        <rect x="190" y="100" width="12" height="12" rx="3" fill="#777"/>
      </g>
    </g>
  )}

  {step === 2 && (
    <g>
      <!-- window frame -->
      <g filter={`url(#${id}-sh)`}>
        <rect x="88" y="34" width="144" height="116" rx="5" fill={`url(#${id}-metal)`} />
        <rect x="100" y="46" width="120" height="92" rx="2" fill="#1a1a1a" />
        <rect x="100" y="46" width="120" height="92" rx="2" fill={`url(#${id}-glass)`} />
        <path d="M100 138l50-92h22l-50 92z" fill="#fff" opacity=".13"/>
        <rect x="157" y="46" width="6" height="92" fill={`url(#${id}-metal)`} />
        <rect x="150" y="84" width="3" height="14" rx="1.5" fill="#444"/>
      </g>
      <!-- width dimension -->
      <g stroke="#fff" stroke-width="1.6" stroke-linecap="round" fill="none">
        <line x1="88" y1="20" x2="88" y2="30"/><line x1="232" y1="20" x2="232" y2="30"/>
        <line x1="92" y1="25" x2="228" y2="25"/>
        <path d="M92 25l7-4M92 25l7 4M228 25l-7-4M228 25l-7 4"/>
      </g>
      <rect x="140" y="17" width="40" height="16" rx="8" fill="#B8794A" stroke="#fff" stroke-opacity=".6"/>
      <text x="160" y="29" text-anchor="middle" font-size="10" fill="#fff" font-family="monospace">1200</text>
      <!-- height dimension -->
      <g stroke="#fff" stroke-width="1.6" stroke-linecap="round" fill="none">
        <line x1="244" y1="34" x2="254" y2="34"/><line x1="244" y1="150" x2="254" y2="150"/>
        <line x1="249" y1="38" x2="249" y2="146"/>
        <path d="M249 38l-4 7M249 38l4 7M249 146l-4-7M249 146l4-7"/>
      </g>
      <rect x="260" y="84" width="40" height="16" rx="8" fill="#B8794A" stroke="#fff" stroke-opacity=".6"/>
      <text x="280" y="96" text-anchor="middle" font-size="10" fill="#fff" font-family="monospace">1500</text>
      <!-- tape measure -->
      <g filter={`url(#${id}-sh)`}>
        <rect x="26" y="108" width="52" height="46" rx="12" fill={`url(#${id}-dark)`} stroke="#fff" stroke-opacity=".6"/>
        <circle cx="46" cy="131" r="10" fill="#0c0c0c" stroke="#9a9a9a" stroke-width="2"/>
        <rect x="58" y="140" width="22" height="9" rx="2" fill={`url(#${id}-metal)`}/>
        <path d="M26 146H8v7h22z" fill="#e8e8e8"/>
        <g stroke="#333" stroke-width="1"><line x1="12" y1="146" x2="12" y2="150"/><line x1="17" y1="146" x2="17" y2="152"/><line x1="22" y1="146" x2="22" y2="150"/></g>
      </g>
      <!-- laser point -->
      <g filter={`url(#${id}-sh)`}>
        <rect x="26" y="54" width="30" height="48" rx="8" fill={`url(#${id}-metal)`}/>
        <rect x="32" y="62" width="18" height="12" rx="3" fill="#1a1a1a"/>
        <text x="41" y="71" text-anchor="middle" font-size="7" fill="#fff" font-family="monospace">1.2m</text>
        <circle cx="41" cy="88" r="4" fill="#333"/>
      </g>
      <line x1="56" y1="60" x2="88" y2="60" stroke="#fff" stroke-opacity=".7" stroke-dasharray="2 4"/>
      <circle cx="88" cy="60" r="3.5" fill="#fff"/>
    </g>
  )}

  {step === 3 && (
    <g>
      <!-- quote sheet -->
      <g filter={`url(#${id}-sh)`}>
        <rect x="150" y="18" width="130" height="152" rx="10" fill={`url(#${id}-paper)`}/>
        <rect x="164" y="32" width="46" height="8" rx="4" fill="#2a2a2a"/>
        <text x="266" y="40" text-anchor="end" font-size="9" fill="#555" font-family="monospace">QUOTE</text>
        <g stroke="#bdbdbd" stroke-width="3.5" stroke-linecap="round">
          <line x1="164" y1="62" x2="222" y2="62"/><line x1="164" y1="80" x2="214" y2="80"/><line x1="164" y1="98" x2="224" y2="98"/>
        </g>
        <g stroke="#6b6b6b" stroke-width="3.5" stroke-linecap="round">
          <line x1="244" y1="62" x2="266" y2="62"/><line x1="244" y1="80" x2="266" y2="80"/><line x1="244" y1="98" x2="266" y2="98"/>
        </g>
        <line x1="164" y1="114" x2="266" y2="114" stroke="#8a8a8a"/>
        <rect x="164" y="124" width="102" height="30" rx="8" fill={`url(#${id}-dark)`}/>
        <text x="176" y="143" font-size="9" fill="#cfcfcf" font-family="monospace">TOTAL</text>
        <rect x="222" y="136" width="34" height="7" rx="3.5" fill="#B8794A"/>
      </g>
      <!-- approved stamp -->
      <g transform="rotate(-14 262 136)" filter={`url(#${id}-sh)`}>
        <circle cx="262" cy="146" r="22" fill="#B8794A" stroke="#fff" stroke-width="2.4"/>
        <path d="M251 146l8 8 14-16" stroke="#fff" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      </g>
      <!-- material samples: aluminium profiles -->
      <g filter={`url(#${id}-sh)`}>
        <rect x="30" y="118" width="96" height="14" rx="4" fill={`url(#${id}-metal)`}/>
        <rect x="30" y="102" width="96" height="14" rx="4" fill={`url(#${id}-dark)`} stroke="#fff" stroke-opacity=".4"/>
        <rect x="30" y="134" width="96" height="14" rx="4" fill={`url(#${id}-metal)`}/>
        <g fill="#0c0c0c" opacity=".35"><rect x="38" y="122" width="40" height="3" rx="1.5"/><rect x="38" y="138" width="40" height="3" rx="1.5"/></g>
      </g>
      <!-- glass sample -->
      <g filter={`url(#${id}-sh)`} transform="translate(16 18) rotate(-6 70 70)">
        <rect x="30" y="26" width="70" height="66" rx="5" fill="#0c0c0c" stroke={`url(#${id}-metal)`} stroke-width="5"/>
        <rect x="33" y="29" width="64" height="60" rx="3" fill={`url(#${id}-glass)`}/>
        <path d="M36 86l30-56h12L48 86z" fill="#fff" opacity=".22"/>
      </g>
      <!-- roof tile sample -->
      <g filter={`url(#${id}-sh)`}>
        <path d="M92 70l30-10 12 28-30 10z" fill={`url(#${id}-dark)`} stroke="#fff" stroke-opacity=".5"/>
        <path d="M100 68l10 24M108 65l10 24M116 62l10 24" stroke="#fff" stroke-opacity=".25"/>
      </g>
    </g>
  )}

  {step === 4 && (
    <g>
      <!-- wall -->
      <g filter={`url(#${id}-sh)`}>
        <rect x="40" y="22" width="240" height="152" rx="8" fill={`url(#${id}-dark)`} stroke="#fff" stroke-opacity=".25"/>
      </g>
      <g stroke="#fff" stroke-opacity=".12" stroke-width="1.4">
        <path d="M40 54h240M40 86h240M40 118h240M40 150h240"/>
        <path d="M80 22v32M140 22v32M200 22v32M250 22v32M60 54v32M120 54v32M180 54v32M240 54v32M80 86v32M140 86v32M200 86v32M260 86v32M60 118v32M120 118v32M180 118v32M240 118v32M80 150v24M160 150v24M230 150v24"/>
      </g>
      <!-- opening + window -->
      <rect x="104" y="40" width="112" height="116" rx="2" fill="#0a0a0a"/>
      <g filter={`url(#${id}-sh)`}>
        <rect x="108" y="44" width="104" height="108" rx="3" fill={`url(#${id}-metal)`}/>
        <rect x="117" y="53" width="86" height="90" rx="2" fill="#151515"/>
        <rect x="117" y="53" width="86" height="90" rx="2" fill={`url(#${id}-glass)`}/>
        <path d="M117 143l40-90h18l-40 90z" fill="#fff" opacity=".16"/>
        <rect x="157" y="53" width="6" height="90" fill={`url(#${id}-metal)`}/>
        <rect x="167" y="94" width="3" height="14" rx="1.5" fill="#444"/>
      </g>
      <!-- spirit level -->
      <g filter={`url(#${id}-sh)`}>
        <rect x="92" y="28" width="136" height="14" rx="4" fill={`url(#${id}-dark)`} stroke="#fff" stroke-opacity=".6"/>
        <rect x="146" y="31" width="28" height="8" rx="4" fill="#d9a178"/>
        <circle cx="160" cy="35" r="3" fill="#0c0c0c"/>
      </g>
      <!-- drill -->
      <g filter={`url(#${id}-sh)`} transform="translate(-4 4)">
        <path d="M236 100h34a8 8 0 0 1 8 8v12a8 8 0 0 1-8 8h-18l-4 28h-14l4-28h-2a8 8 0 0 1-8-8v-12a8 8 0 0 1 8-8z" fill={`url(#${id}-metal)`} stroke="#fff" stroke-opacity=".4"/>
        <rect x="216" y="108" width="20" height="12" rx="3" fill="#2a2a2a"/>
        <rect x="204" y="112" width="14" height="4" rx="2" fill="#e8e8e8"/>
        <circle cx="262" cy="114" r="3" fill="#0c0c0c"/>
      </g>
      <!-- sparkle -->
      <g class="fs-twinkle" fill="#d9a178"><path d="M72 108l3 8 8 3-8 3-3 8-3-8-8-3 8-3z"/><path d="M262 60l2 5 5 2-5 2-2 5-2-5-5-2 5-2z" opacity=".8"/></g>
    </g>
  )}
</svg>
