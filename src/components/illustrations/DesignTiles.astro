---
/** A grid of isometric tiles, each with a small architectural symbol. Drawn in code. */
const w = 86, h = 43, t = 12, gapX = 104, gapY = 54;
type Icon = "window" | "door" | "roof" | "glass" | "rail" | "tile" | "none";
const cycle: Icon[] = ["window", "none", "door", "roof", "glass", "tile", "rail", "none", "roof", "window", "tile", "door", "glass", "rail", "none"];

const tiles: { cx: number; cy: number; icon: Icon }[] = [];
let n = 0;
for (let i = 0; i < 7; i++) {
  for (let j = 0; j < 7; j++) {
    const cx = 30 + i * gapX * 0.75;
    const cy = 40 + j * gapY + (i % 2) * (gapY / 2);
    tiles.push({ cx, cy, icon: cycle[n++ % cycle.length] });
  }
}
tiles.sort((a, b) => a.cy - b.cy || a.cx - b.cx);

const top = (cx: number, cy: number) =>
  `${cx - w / 2},${cy} ${cx - w / 4},${cy - h / 2} ${cx + w / 4},${cy - h / 2} ${cx + w / 2},${cy} ${cx + w / 4},${cy + h / 2} ${cx - w / 4},${cy + h / 2}`;
const leftFace = (cx: number, cy: number) =>
  `${cx - w / 2},${cy} ${cx - w / 4},${cy + h / 2} ${cx - w / 4},${cy + h / 2 + t} ${cx - w / 2},${cy + t}`;
const frontFace = (cx: number, cy: number) =>
  `${cx - w / 4},${cy + h / 2} ${cx + w / 4},${cy + h / 2} ${cx + w / 4},${cy + h / 2 + t} ${cx - w / 4},${cy + h / 2 + t}`;
const rightFace = (cx: number, cy: number) =>
  `${cx + w / 4},${cy + h / 2} ${cx + w / 2},${cy} ${cx + w / 2},${cy + t} ${cx + w / 4},${cy + h / 2 + t}`;
---

<svg viewBox="0 0 560 380" preserveAspectRatio="xMaxYMax slice" class="h-full w-full" fill="none" role="img" aria-label="Grid of tiles with window, door, roof, glass and handrail symbols">
  {tiles.map(({ cx, cy, icon }) => (
    <g stroke="#2067F5" stroke-width="1.1" stroke-linejoin="round">
      <polygon points={leftFace(cx, cy)} fill="#2067F5" fill-opacity="0.20" />
      <polygon points={frontFace(cx, cy)} fill="#2067F5" fill-opacity="0.28" />
      <polygon points={rightFace(cx, cy)} fill="#2067F5" fill-opacity="0.20" />
      <polygon points={top(cx, cy)} fill="#0055FF" fill-opacity="0.13" stroke-opacity="0.95" />
      {icon !== "none" && (
        <g transform={`translate(${cx - 13} ${cy - 14}) scale(1.08)`} stroke="#dbe7ff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none">
          {icon === "window" && (<><rect x="3" y="3" width="18" height="18" /><line x1="12" y1="3" x2="12" y2="21" /><line x1="3" y1="12" x2="21" y2="12" /></>)}
          {icon === "door" && (<><rect x="6" y="2" width="12" height="20" /><rect x="8.5" y="4.5" width="7" height="6" /><circle cx="15" cy="15" r="0.9" fill="#dbe7ff" /></>)}
          {icon === "roof" && (<><polyline points="2,12 12,4 22,12" /><polyline points="5,11 5,20 19,20 19,11" /></>)}
          {icon === "glass" && (<><rect x="4" y="3" width="16" height="18" /><line x1="8" y1="17" x2="16" y2="9" /><line x1="8" y1="12" x2="12" y2="8" /></>)}
          {icon === "rail" && (<><line x1="2" y1="8" x2="22" y2="8" /><line x1="6" y1="8" x2="6" y2="20" /><line x1="12" y1="8" x2="12" y2="20" /><line x1="18" y1="8" x2="18" y2="20" /></>)}
          {icon === "tile" && (<><path d="M3 8h18M3 14h18M3 20h18" /><path d="M9 3v5M15 8v6M9 14v6" /></>)}
        </g>
      )}
    </g>
  ))}
</svg>
