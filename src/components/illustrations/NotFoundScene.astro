---
/** Big "404": the two 4s are aluminium extrusions, the 0 is a window with someone looking out, confused. */
const four = "M130 0H178V160H200V204H178V260H130V204H0V164Z M130 48L52 160H130Z";
---
<svg viewBox="0 0 800 350" class="nf-scene h-auto w-full" role="img" aria-label="404: a window shaped like a zero with a puzzled person looking out" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="nf-ink" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#4b4b4b"/><stop offset=".45" stop-color="#161616"/><stop offset="1" stop-color="#050505"/></linearGradient>
    <linearGradient id="nf-metal" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fafafa"/><stop offset=".45" stop-color="#b4b4b4"/><stop offset="1" stop-color="#ececec"/></linearGradient>
    <linearGradient id="nf-room" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f7f7f7"/><stop offset="1" stop-color="#cfcfcf"/></linearGradient>
    <linearGradient id="nf-glass" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".55"/><stop offset=".5" stop-color="#fff" stop-opacity=".08"/><stop offset="1" stop-color="#fff" stop-opacity=".3"/></linearGradient>
    <clipPath id="nf-open"><rect x="312" y="42" width="176" height="236" rx="42"/></clipPath>
    <filter id="nf-sh" x="-10%" y="-10%" width="120%" height="130%"><feDropShadow dx="0" dy="10" stdDeviation="9" flood-color="#000" flood-opacity=".28"/></filter>
  </defs>

  <ellipse cx="400" cy="312" rx="360" ry="14" fill="#000" opacity=".12"/>

  <!-- 4 and 4 -->
  {[30, 570].map((x, i) => (
    <g transform={`translate(${x} 30)`}><g filter="url(#nf-sh)" class="nf-four" style={`animation-delay:${i * -1.6}s`}>
      <path d={four} fill="url(#nf-ink)" fill-rule="evenodd"/>
      <path d="M130 0H178V160H200" fill="none" stroke="#fff" stroke-opacity=".35" stroke-width="2"/>
      <path d="M0 164L130 0" fill="none" stroke="#fff" stroke-opacity=".3" stroke-width="2"/>
      <path d="M130 48L52 160" fill="none" stroke="#fff" stroke-opacity=".18" stroke-width="2"/>
      <g fill="#B8794A" opacity=".9"><circle cx="154" cy="22" r="3"/><circle cx="154" cy="238" r="3"/><circle cx="20" cy="184" r="3"/><circle cx="178" cy="184" r="3"/></g>
    </g></g>
  ))}

  <!-- 0 as a window -->
  <g filter="url(#nf-sh)">
    <rect x="290" y="20" width="220" height="280" rx="64" fill="url(#nf-metal)"/>
    <rect x="290" y="20" width="220" height="280" rx="64" fill="none" stroke="#fff" stroke-width="2.5"/>
    <rect x="300" y="30" width="200" height="260" rx="54" fill="none" stroke="#8a8a8a" stroke-width="1.6"/>
  </g>
  <rect x="312" y="42" width="176" height="236" rx="42" fill="url(#nf-room)"/>
  <g clip-path="url(#nf-open)">
    <!-- room behind: soft shelf line + lamp glow -->
    <rect x="312" y="232" width="176" height="46" fill="#bdbdbd"/>
    <ellipse cx="456" cy="86" rx="60" ry="46" fill="#fff" opacity=".6"/>
    <g class="nf-peep">
      <image href="/images/peeps/hijab.webp" x="326" y="78" width="148" height="214" />
    </g>
    <!-- question marks -->
    <g font-family="var(--font-clash-grotesk), sans-serif" font-weight="600" fill="#B8794A">
      <text class="nf-q" x="448" y="96" font-size="34">?</text>
      <text class="nf-q nf-q2" x="334" y="118" font-size="22">?</text>
    </g>
    <!-- glass: sheen sweeps across -->
    <rect x="312" y="42" width="176" height="236" fill="url(#nf-glass)"/>
    <g class="nf-sheen"><path d="M300 290L360 30h26L326 290z" fill="#fff" opacity=".35"/><path d="M394 290L424 30h10L404 290z" fill="#fff" opacity=".25"/></g>
  </g>
  <!-- mullion + handle -->
  <rect x="470" y="150" width="5" height="30" rx="2.5" fill="#555"/>
  <!-- tiny sill -->
  <rect x="280" y="298" width="240" height="12" rx="6" fill="url(#nf-metal)"/>

  <!-- measuring line -->
  <g stroke="#0c0c0c" stroke-width="1.6" stroke-linecap="round" fill="none" opacity=".75">
    <line x1="30" y1="330" x2="770" y2="330" stroke-dasharray="1 7"/>
    <path d="M30 322v16M770 322v16"/>
  </g>
  <rect x="318" y="318" width="164" height="24" rx="12" fill="#B8794A"/>
  <text x="400" y="334.5" text-anchor="middle" font-size="12" fill="#fff" font-family="monospace">width: not found</text>
</svg>

<style>
  .nf-four { animation: nf-float 5s ease-in-out infinite; }
  .nf-peep { transform-box: fill-box; transform-origin: 50% 100%; animation: nf-look 4.6s ease-in-out infinite; }
  .nf-q { transform-box: fill-box; transform-origin: 50% 100%; animation: nf-pop 2.6s ease-in-out infinite; }
  .nf-q2 { animation-delay: -1.3s; }
  .nf-sheen { animation: nf-sweep 5.5s ease-in-out infinite; }
  @keyframes nf-float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
  @keyframes nf-look { 0%,100% { transform: translateX(-6px) rotate(-2deg); } 50% { transform: translateX(6px) rotate(2deg); } }
  @keyframes nf-pop { 0%,100% { transform: translateY(0) scale(1); opacity: .9; } 50% { transform: translateY(-6px) scale(1.12); opacity: 1; } }
  @keyframes nf-sweep { 0% { transform: translateX(-140px); } 55%,100% { transform: translateX(210px); } }
  @media (prefers-reduced-motion: reduce) { .nf-four, .nf-peep, .nf-q, .nf-sheen { animation: none; } }
</style>
