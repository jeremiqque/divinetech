---
/**
 * Exploded isometric drawing of a window build-up: glass, aluminium frame, finished base.
 * Drawn in code so it stays sharp at any size.
 */
const k = 1, C = 0.866, S = 0.5;
const cx = 200, cy = 178, W = 190, T = 18;
const iso = (x: number, y: number, z: number) =>
  `${(cx + (x - y) * C * k).toFixed(1)},${(cy + (x + y) * S * k - z * k).toFixed(1)}`;
const poly = (pts: [number, number, number][]) => pts.map(([x, y, z]) => iso(x, y, z)).join(" ");

const slabs = [
  { z0: 0, label: "CAREFUL FINISH", kind: "base" },
  { z0: 74, label: "ALUMINIUM FRAME", kind: "frame" },
  { z0: 148, label: "QUALITY GLASS", kind: "glass" },
] as const;

const corners: [number, number][] = [[0, 0], [W, 0], [W, W], [0, W]];
const inset = 22;
const [lx, ly] = iso(W, W - 14, 0).split(",").map(Number); // reference only
const textMatrix = (z: number) => {
  const [e, f] = iso(W, W - 12, z).split(",").map(Number);
  return `matrix(${C} ${-S} 0 1 ${e} ${f})`;
};
---

<svg viewBox="0 0 400 400" preserveAspectRatio="xMidYMax meet" class="h-full w-full" fill="none" role="img" aria-label="Exploded drawing of a window: glass, aluminium frame and finished base">
  <defs>
    <linearGradient id="q-glass" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#5AF63A" stop-opacity="0.22" />
      <stop offset="1" stop-color="#3FA02B" stop-opacity="0.08" />
    </linearGradient>
  </defs>

  <!-- ground shadow and construction lines -->
  <ellipse cx="200" cy="372" rx="150" ry="14" fill="#3FA02B" fill-opacity="0.10" />
  {slabs.slice(0, 2).map((s, i) => corners.map(([x, y]) => (
    <line
      x1={iso(x, y, s.z0 + T).split(",")[0]} y1={iso(x, y, s.z0 + T).split(",")[1]}
      x2={iso(x, y, slabs[i + 1].z0).split(",")[0]} y2={iso(x, y, slabs[i + 1].z0).split(",")[1]}
      stroke="#5AF63A" stroke-opacity="0.45" stroke-dasharray="3 5" stroke-width="1"
    />
  )))}

  {slabs.map((s) => {
    const z1 = s.z0 + T;
    return (
      <g stroke-linejoin="round">
        <!-- left face and right face -->
        <polygon points={poly([[0, W, s.z0], [W, W, s.z0], [W, W, z1], [0, W, z1]])} fill="#3FA02B" fill-opacity="0.16" stroke="#3FA02B" stroke-width="1.2" />
        <polygon points={poly([[W, W, s.z0], [W, 0, s.z0], [W, 0, z1], [W, W, z1]])} fill="#3FA02B" fill-opacity="0.26" stroke="#3FA02B" stroke-width="1.2" />
        <!-- top face -->
        <polygon points={poly([[0, 0, z1], [W, 0, z1], [W, W, z1], [0, W, z1]])} fill={s.kind === "glass" ? "url(#q-glass)" : "#3FA02B"} fill-opacity={s.kind === "glass" ? 1 : 0.14} stroke="#5AF63A" stroke-opacity="0.85" stroke-width="1.3" />
        {s.kind !== "glass" && (
          <polygon points={poly([[inset, inset, z1], [W - inset, inset, z1], [W - inset, W - inset, z1], [inset, W - inset, z1]])} fill="#0E0F11" fill-opacity="0.55" stroke="#5AF63A" stroke-opacity="0.55" stroke-width="1" />
        )}
        {s.kind === "frame" && (
          <>
            <line x1={iso(W / 2, inset, z1).split(",")[0]} y1={iso(W / 2, inset, z1).split(",")[1]} x2={iso(W / 2, W - inset, z1).split(",")[0]} y2={iso(W / 2, W - inset, z1).split(",")[1]} stroke="#5AF63A" stroke-opacity="0.6" />
            <line x1={iso(inset, W / 2, z1).split(",")[0]} y1={iso(inset, W / 2, z1).split(",")[1]} x2={iso(W - inset, W / 2, z1).split(",")[0]} y2={iso(W - inset, W / 2, z1).split(",")[1]} stroke="#5AF63A" stroke-opacity="0.6" />
          </>
        )}
        <!-- fixing screws -->
        {[[10, 10], [W - 10, 10], [W - 10, W - 10], [10, W - 10]].map(([x, y]) => (
          <ellipse cx={iso(x, y, z1).split(",")[0]} cy={iso(x, y, z1).split(",")[1]} rx="4.2" ry="2.4" fill="#F2FA00" fill-opacity="0.9" stroke="#0E0F11" stroke-width="0.8" />
        ))}
        <text transform={textMatrix(s.z0 + 5)} font-family="ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" font-size="10.5" letter-spacing="1.2" fill="#d9ffd0">{s.label}</text>
      </g>
    );
  })}

</svg>
