---
/**
 * A button that is a link (goes to another page / WhatsApp / phone).
 * Same two looks as the Button component: dark and light.
 */
interface Props {
  href: string;
  variant?: "dark" | "light";
  class?: string;
  external?: boolean;
}
const { href, variant = "dark", class: className = "", external = false } = Astro.props;

const base =
  "relative inline-flex cursor-pointer items-center justify-center gap-2 whitespace-nowrap font-medium transition-[transform,filter] duration-200 hover:brightness-110 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring [&_svg]:size-5 [&_svg]:shrink-0";
const looks = {
  dark: "rounded-[14px] border-[1.06px] border-accent/60 p-0 text-white",
  light: "rounded-button bg-white p-4 text-base text-black",
};
const ext = external ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<a href={href} class:list={[base, looks[variant], className]} {...ext}>
  {variant === "dark" && (
    <span class="flex h-[54px] items-center justify-center gap-2 rounded-[10px] border-[0.53px] border-white/40 bg-gradient-to-b from-dark-top to-dark-bottom px-[19px] text-[15.3px] leading-none tracking-[-0.3px] text-white">
      <slot />
    </span>
  )}
  {variant === "light" && <slot />}
</a>
